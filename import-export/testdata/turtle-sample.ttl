# YAGO-style Turtle sample
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix yago: <http://yago-knowledge.org/schema/>.
@prefix dbo: <http://dbpedia.org/ontology/>.

<http://yago-knowledge.org/resource/Barack_Obama>
    rdf:type dbo:Person ;
    dbo:birthDate "1961-08-04"^^xsd:date ;
    dbo:name "Barack Obama" ;
    dbo:spouse <http://yago-knowledge.org/resource/Michelle_Obama> .

<http://yago-knowledge.org/resource/Michelle_Obama>
    rdf:type dbo:Person ;
    dbo:birthDate "1964-01-17"^^xsd:date ;
    dbo:name "Michelle Obama" .

<http://yago-knowledge.org/resource/Hope_College>
    rdf:type dbo:EducationalInstitution ;
    dbo:name "Hope College" ;
    dbo:location <http://yago-knowledge.org/resource/Hopkins_Minnesota> .

<http://yago-knowledge.org/resource/Hopkins_Minnesota>
    rdf:type dbo:Place .